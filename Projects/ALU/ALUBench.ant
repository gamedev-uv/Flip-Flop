library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
USE IEEE.STD_LOGIC_TEXTIO.ALL;
USE IEEE.STD_LOGIC_ARITH.ALL;
USE IEEE.STD_LOGIC_UNSIGNED.ALL;
USE STD.TEXTIO.ALL;

ENTITY ALUBench IS
END ALUBench;

ARCHITECTURE testbench_arch OF ALUBench IS
    FILE RESULTS: TEXT OPEN WRITE_MODE IS "C:\Projects\Xilinx Projects\Flip-Flop\Projects\ALU\ALUBench.ano";

    COMPONENT ALU
        PORT (
            A : In std_logic_vector (3 DownTo 0);
            B : In std_logic_vector (3 DownTo 0);
            S : In std_logic_vector (3 DownTo 0);
            C : In std_logic;
            O : Out std_logic_vector (3 DownTo 0);
            CARRY : Out std_logic
        );
    END COMPONENT;

    SIGNAL A : std_logic_vector (3 DownTo 0) := "0101";
    SIGNAL B : std_logic_vector (3 DownTo 0) := "0000";
    SIGNAL S : std_logic_vector (3 DownTo 0) := "0000";
    SIGNAL C : std_logic := '0';
    SIGNAL O : std_logic_vector (3 DownTo 0) := "0101";
    SIGNAL CARRY : std_logic := '0';

    SHARED VARIABLE TX_ERROR : INTEGER := 0;
    SHARED VARIABLE TX_OUT : LINE;

    BEGIN
        UUT : ALU
        PORT MAP (
            A => A,
            B => B,
            S => S,
            C => C,
            O => O,
            CARRY => CARRY
        );

        PROCESS    -- Annotation process
            VARIABLE TX_TIME : INTEGER := 0;

            PROCEDURE ANNOTATE_O(
                TX_TIME : INTEGER
            ) IS
                VARIABLE TX_STR : String(1 to 4096);
                VARIABLE TX_LOC : LINE;
            BEGIN
                STD.TEXTIO.write(TX_LOC, string'("Annotate["));
                STD.TEXTIO.write(TX_LOC, TX_TIME);
                STD.TEXTIO.write(TX_LOC, string'(", O, "));
                IEEE.STD_LOGIC_TEXTIO.write(TX_LOC, O);
                STD.TEXTIO.write(TX_LOC, string'("]"));
                TX_STR(TX_LOC.all'range) := TX_LOC.all;
                STD.TEXTIO.writeline(RESULTS, TX_LOC);
                STD.TEXTIO.Deallocate(TX_LOC);
            END;
            PROCEDURE ANNOTATE_CARRY(
                TX_TIME : INTEGER
            ) IS
                VARIABLE TX_STR : String(1 to 4096);
                VARIABLE TX_LOC : LINE;
            BEGIN
                STD.TEXTIO.write(TX_LOC, string'("Annotate["));
                STD.TEXTIO.write(TX_LOC, TX_TIME);
                STD.TEXTIO.write(TX_LOC, string'(", CARRY, "));
                IEEE.STD_LOGIC_TEXTIO.write(TX_LOC, CARRY);
                STD.TEXTIO.write(TX_LOC, string'("]"));
                TX_STR(TX_LOC.all'range) := TX_LOC.all;
                STD.TEXTIO.writeline(RESULTS, TX_LOC);
                STD.TEXTIO.Deallocate(TX_LOC);
            END;
        BEGIN
            WAIT for 1 fs;
            ANNOTATE_O(0);
            ANNOTATE_CARRY(0);
            ANNO_LOOP : LOOP
                WAIT for 20 ns;
                TX_TIME := TX_TIME + 20;
                ANNOTATE_O(TX_TIME);
                ANNOTATE_CARRY(TX_TIME);
                WAIT for 20 ns;
                TX_TIME := TX_TIME + 20;
            END LOOP ANNO_LOOP;
        END PROCESS;

        PROCESS
            BEGIN
                -- -------------  Current Time:  40ns
                WAIT FOR 40 ns;
                A <= "1100";
                B <= "0011";
                -- -------------------------------------
                -- -------------  Current Time:  80ns
                WAIT FOR 40 ns;
                A <= "1001";
                B <= "0110";
                S <= "0001";
                -- -------------------------------------
                -- -------------  Current Time:  120ns
                WAIT FOR 40 ns;
                A <= "0001";
                B <= "0000";
                S <= "0010";
                -- -------------------------------------
                -- -------------  Current Time:  160ns
                WAIT FOR 40 ns;
                A <= "1110";
                B <= "1000";
                S <= "0011";
                -- -------------------------------------
                -- -------------  Current Time:  200ns
                WAIT FOR 40 ns;
                C <= '1';
                A <= "0111";
                B <= "1100";
                S <= "0100";
                -- -------------------------------------
                -- -------------  Current Time:  240ns
                WAIT FOR 40 ns;
                S <= "0101";
                -- -------------------------------------
                -- -------------  Current Time:  280ns
                WAIT FOR 40 ns;
                A <= "1010";
                B <= "1000";
                S <= "0110";
                -- -------------------------------------
                -- -------------  Current Time:  320ns
                WAIT FOR 40 ns;
                A <= "1110";
                B <= "1100";
                S <= "0111";
                -- -------------------------------------
                -- -------------  Current Time:  360ns
                WAIT FOR 40 ns;
                C <= '0';
                B <= "1110";
                S <= "1000";
                -- -------------------------------------
                -- -------------  Current Time:  400ns
                WAIT FOR 40 ns;
                B <= "1010";
                S <= "1001";
                -- -------------------------------------
                -- -------------  Current Time:  440ns
                WAIT FOR 40 ns;
                A <= "1011";
                B <= "1000";
                S <= "1010";
                -- -------------------------------------
                -- -------------  Current Time:  480ns
                WAIT FOR 40 ns;
                B <= "0000";
                S <= "1011";
                -- -------------------------------------
                -- -------------  Current Time:  520ns
                WAIT FOR 40 ns;
                C <= '1';
                A <= "1110";
                B <= "0100";
                S <= "1100";
                -- -------------------------------------
                -- -------------  Current Time:  560ns
                WAIT FOR 40 ns;
                A <= "1100";
                B <= "1110";
                S <= "1101";
                -- -------------------------------------
                -- -------------  Current Time:  600ns
                WAIT FOR 40 ns;
                A <= "1000";
                B <= "1010";
                S <= "1110";
                -- -------------------------------------
                -- -------------  Current Time:  640ns
                WAIT FOR 40 ns;
                A <= "1100";
                B <= "0010";
                S <= "1111";
                -- -------------------------------------
                -- -------------  Current Time:  680ns
                WAIT FOR 40 ns;
                C <= '0';
                A <= "0000";
                B <= "0000";
                S <= "0000";
                WAIT FOR 320 ns;

                STD.TEXTIO.write(TX_OUT, string'("Total[]"));
                STD.TEXTIO.writeline(RESULTS, TX_OUT);
                ASSERT (FALSE) REPORT
                    "Success! Simulation for annotation completed"
                    SEVERITY FAILURE;
            END PROCESS;

    END testbench_arch;

