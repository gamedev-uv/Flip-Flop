set -tmpdir ./xst/projnav.tmp
set -xsthdpdir ./xst
run
-ifn DEMUX1x4.prj
-ifmt mixed
-ofn DEMUX1x4
-ofmt NGC
-p acr2
-top DEMUX1x4
-opt_mode Speed
-opt_level 1
-iuc NO
-lso DEMUX1x4.lso
-keep_hierarchy YES
-rtlview Yes
-hierarchy_separator /
-bus_delimiter <>
-case maintain
-verilog2001 YES
-fsm_extract YES -fsm_encoding Auto
-safe_implementation No
-mux_extract YES
-resource_sharing YES
-iobuf YES
-pld_mp YES
-pld_xp YES
-wysiwyg NO
-equivalent_register_removal YES
